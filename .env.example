# =========================================================
# EURO - Academic Unit Test 1 & 2 Management System
# Production & Deployment Environment Configuration
# =========================================================

# Node Environment: 'production' for live deployments, 'development' for local work
NODE_ENV=production

# Server Port (Default is 3000, mapped automatically by container/cloud platforms)
PORT=3000

# SQLite / Relational Database path or connection string
# Local default: euro_unit_test.db
DATABASE_PATH=euro_unit_test.db
# Optional hosted PostgreSQL connection string for enterprise scaling:
# DATABASE_URL=postgresql://user:password@host:5432/euro_db

# Google Gemini AI API Key (Used for AI Academic Advisory, OCR Parsing, and Continuous Analytics)
# Configured via AI Studio Secrets in Cloud Run or environment secrets on Render/Railway
GEMINI_API_KEY=

# Public Application URL (Injected automatically in Cloud Run or set to your custom domain)
APP_URL=https://your-app-domain.com

# Session Secret (Optional secret key used for session signing and hashing)
SESSION_SECRET=change_this_to_a_secure_random_secret_in_production

